{
  "productName": "Monochrome",
  "version": "1.1.1",
  "identifier": "com.monochrome.music",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://monochrome.tf",
    "frontendDist": "dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "category": "Music",
    "shortDescription": "Minimalist, unlimited music streaming",
    "longDescription": "A lightweight desktop wrapper for monochrome.tf with system tray, Discord Rich Presence, media keys, and desktop notifications.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "sound",
        "priority": "optional"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        "main-capability",
        "desktop-capability"
      ]
    }
  }
}